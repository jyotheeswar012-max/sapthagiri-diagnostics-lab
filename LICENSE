        +(ME.role==='owner'&&r.status==='pending'?'<button class="btn btn-gold btn-sm" onclick="markReady(\''+r._id+'\')">&#x2713; Ready</button>':'')
        +'</div></div>').join('')
      +'</div>';
  }catch(e){c.innerHTML=errCard(e);}
}

// SCHEDULE (CALENDAR)
async function rSchedule(c){
  try{
    let docId=ME.id, docName=ME.name, docSelHtml='';
    if(ME.role==='owner'){
      const docs=await api('GET','/staff/doctors').catch(()=>[]);
      if(docs.length){
        docId=docs[0]._id; docName=docs[0].name;
        docSelHtml='<select onchange="reloadSched(this.value)" style="font-size:.85rem;padding:.45rem .8rem;border:1.5px solid var(--border);border-radius:6px;background:var(--surface2);color:var(--text);font-family:\'Nunito\',sans-serif;outline:none">'
          +docs.map(d=>'<option value="'+d._id+'">'+d.name+' — '+(d.speciality||'')+'</option>').join('')+'</select>';
      }
    }
    window._schedDocId=docId;
    const sched=await api('GET','/appointments/schedule/doctor/'+docId).catch(()=>({}));
    const today=new Date(), y=today.getFullYear(), m=today.getMonth();
    const firstDay=new Date(y,m,1).getDay(), daysInMonth=new Date(y,m+1,0).getDate();
    const mname=today.toLocaleDateString('en-IN',{month:'long',year:'numeric'});
    let days='';
    for(let i=0;i<firstDay;i++) days+='<div></div>';
    for(let d=1;d<=daysInMonth;d++){
      const ds=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
      const isT=d===today.getDate(), ap=sched[ds]||[];
      days+='<div class="cal-day '+(isT?'today':'')+' '+(ap.length?'has-appt':'')+'" onclick="showDayAppts(\''+ds+'\',\''+docId+'\')">'
        +'<div class="cn">'+d+'</div>'
        +ap.map(()=>'<span class="cdot"></span>').join('')
        +(ap.length?'<div style="font-size:.62rem;color:var(--teal);font-weight:700">'+ap.length+' appt'+(ap.length>1?'s':'')+'</div>':'')
        +'</div>';
    }
    c.innerHTML='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.2rem;flex-wrap:wrap;gap:.8rem">'
      +'<h3 style="font-family:\'Playfair Display\',serif;font-size:1.1rem;color:var(--text)">&#x1F4C6; '+docName+'&rsquo;s Schedule &mdash; '+mname+'</h3>'
      +docSelHtml+'</div>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start">'
      +'<div class="card"><div class="cal-hd">'+['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>'<div class="cal-dl">'+d+'</div>').join('')+'</div>'
      +'<div class="cal-wrap">'+days+'</div></div>'
      +'<div class="card" id="sched-detail"><p style="color:var(--muted);font-size:.88rem">Click a date to see appointments</p></div>'
      +'</div>';
  }catch(e){c.innerHTML=errCard(e);}
}

async function reloadSched(docId){window._schedDocId=docId;rSchedule(document.getElementById('app-content'));}

async function showDayAppts(ds,docId){
  const el=document.getElementById('sched-detail');
  el.innerHTML='<div class="lr"><div class="spin"></div></div>';
  try{
    const sched=await api('GET','/appointments/schedule/doctor/'+docId);
    const ap=sched[ds]||[];
    el.innerHTML='<h3 style="font-size:.95rem;margin-bottom:1rem;color:var(--text)">'+new Date(ds+'T00:00').toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'})+'</h3>'
      +(ap.length===0?'<p style="color:var(--muted);font-size:.88rem">No appointments.</p>'
      :ap.map(a=>'<div class="ats"><strong>'+a.time+' &mdash; '+(a.patient?.name||'&mdash;')+'</strong><span style="font-size:.75rem;color:var(--muted)">'+(a.tests||[]).join(', ')+'</span> '+sbadge(a.status)+'</div>').join(''));
  }catch(e){el.innerHTML=errCard(e);}
}


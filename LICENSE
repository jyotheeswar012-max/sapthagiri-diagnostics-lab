// PAYMENTS
async function rPayments(c){
  try{
    const ap=await api('GET','/appointments');
    const paid=ap.filter(a=>a.paid),rev=paid.reduce((s,a)=>s+(a.amount||0),0);
    c.innerHTML=(ME.role!=='patient'?'<div class="sr s3" style="margin-bottom:1.2rem">'
      +'<div class="scard"><div class="sic ic-gr">&#x20B9;</div><div class="si"><h4>&#x20B9;'+rev.toLocaleString()+'</h4><p>Collected</p></div></div>'
      +'<div class="scard"><div class="sic ic-g">&#x1F4C4;</div><div class="si"><h4>'+paid.length+'</h4><p>Paid</p></div></div>'
      +'<div class="scard"><div class="sic ic-r">&#x23F3;</div><div class="si"><h4>'+ap.filter(a=>!a.paid).length+'</h4><p>Pending</p></div></div></div>':'')
      +'<div class="tcard"><div class="thead"><h3>Payment Records</h3></div>'
      +'<table><thead><tr><th>Code</th><th>Patient</th><th>Tests</th><th>Amount</th><th>Method</th><th>Status</th><th>Actions</th></tr></thead><tbody>'
      +ap.map(a=>'<tr>'
        +'<td><code style="font-size:.73rem">'+(a.appointmentCode||'&mdash;')+'</code></td>'
        +'<td>'+(a.patient?.name||'&mdash;')+'</td>'
        +'<td>'+(a.tests||[]).slice(0,1).join('')+(a.tests?.length>1?' +'+(a.tests.length-1):'')+'</td>'
        +'<td><strong>&#x20B9;'+(a.amount||0)+'</strong></td>'
        +'<td>'+(a.paymentMethod||'&mdash;')+'</td>'
        +'<td>'+(a.paid?'<span class="badge b-green">Paid</span>':'<span class="badge b-red">Unpaid</span>')+'</td>'
        +'<td style="display:flex;gap:.3rem">'
        +(!a.paid?'<button class="btn btn-gold btn-sm" onclick="openPayModal(\''+a._id+'\',\''+(a.patient?.name||ME.name)+'\','+a.amount+')">&#x1F4B3; Pay</button>':'')
        +(!a.paid&&ME.role==='owner'?'<button class="btn btn-outline btn-sm" onclick="markCash(\''+a._id+'\')">Cash</button>':'')
        +(a.paid?'<button class="btn btn-ghost btn-sm" onclick="dlReceipt(\''+a._id+'\')">&#x1F9FE; Receipt</button>':'')
        +'</td></tr>').join('')
      +'</tbody></table></div>';
  }catch(e){c.innerHTML=errCard(e);}
}

// ANALYTICS
async function rAnalytics(c){
  try{
    const a=await api('GET','/analytics');
    const mx=Math.max(...(a.monthly||[]).map(m=>m.count),1);
    const mt=Math.max(...(a.topTests||[]).map(t=>t.count),1);
    c.innerHTML='<div class="sr s4" style="margin-bottom:1.3rem">'
      +'<div class="scard"><div class="sic ic-t">&#x1F4CA;</div><div class="si"><h4>'+a.totalAppointments+'</h4><p>Total Appts</p></div></div>'
      +'<div class="scard"><div class="sic ic-gr">&#x20B9;</div><div class="si"><h4>&#x20B9;'+(a.totalRevenue||0).toLocaleString()+'</h4><p>Revenue</p></div></div>'
      +'<div class="scard"><div class="sic ic-g">&#x1F465;</div><div class="si"><h4>'+a.totalPatients+'</h4><p>Patients</p></div></div>'
      +'<div class="scard"><div class="sic ic-r">&#x1F4CB;</div><div class="si"><h4>'+a.readyReports+'</h4><p>Reports Ready</p></div></div></div>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem">'
      +'<div class="card"><h3 style="font-size:.95rem;margin-bottom:1rem;color:var(--text)">Monthly Volume</h3>'
      +(a.monthly||[]).map(m=>'<div class="cb-row"><span class="cb-lbl">'+m._id+'</span><div class="cb-track"><div class="cb-fill" style="width:'+Math.round(m.count/mx*100)+'%"></div></div><span class="cb-val">'+m.count+'</span></div>').join('')
      +'</div><div class="card"><h3 style="font-size:.95rem;margin-bottom:1rem;color:var(--text)">Top Tests</h3>'
      +(a.topTests||[]).map(t=>'<div class="cb-row"><span class="cb-lbl">'+(t._id||'').slice(0,9)+'</span><div class="cb-track"><div class="cb-fill" style="width:'+Math.round(t.count/mt*100)+'%;background:linear-gradient(90deg,var(--gold),var(--gold-l))"></div></div><span class="cb-val">'+t.count+'</span></div>').join('')
      +'</div></div>';
  }catch(e){c.innerHTML=errCard(e);}
}


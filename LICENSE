async function openEditAppt(id){
  const a=await api('GET','/appointments/'+id);
  openEdit('Edit Appointment','Editing: '+a.appointmentCode,
    '<div class="fr"><div class="fg"><label>Date</label><input id="ea-dt" type="date" value="'+a.date+'"/></div><div class="fg"><label>Time</label><select id="ea-tm">'+['07:00','08:00','09:00','10:00','11:00','12:00','14:00','15:00','16:00'].map(t=>'<option '+(a.time===t?'selected':'')+'>'+t+'</option>').join('')+'</select></div></div>'
    +'<div class="fg"><label>Status</label><select id="ea-st">'+['upcoming','pending','completed','cancelled'].map(s=>'<option '+(a.status===s?'selected':'')+'>'+s+'</option>').join('')+'</select></div>'
    +'<div class="fg"><label>Collection</label><select id="ea-col"><option value="walkin" '+(a.collectionType==='walkin'?'selected':'')+'>Walk-in</option><option value="home" '+(a.collectionType==='home'?'selected':'')+'>Home</option></select></div>'
    +(ME.role==='owner'?'<div class="fr"><div class="fg"><label>Amount</label><input id="ea-am" type="number" value="'+(a.amount||0)+'"/></div><div class="fg"><label>Notes</label><input id="ea-nt" value="'+(a.notes||'')+'"/></div></div>':''),
  async()=>{
    const body={date:g('ea-dt'),time:g('ea-tm'),status:g('ea-st'),collectionType:g('ea-col')};
    if(ME.role==='owner'){body.amount=Number(g('ea-am'))||0;body.notes=g('ea-nt');}
    await api('PUT','/appointments/'+id,body);toast('Appointment updated');nav('appointments');
  });
}


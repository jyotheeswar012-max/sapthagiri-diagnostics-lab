  '<div class="fr"><div class="fg"><label>Name *</label><input id="es-nm"/></div><div class="fg"><label>Role *</label><select id="es-rl"><option value="">Select</option><option>Lab Technician</option><option>Phlebotomist</option><option>Receptionist</option><option>Home Collection</option><option>Manager</option><option>Accountant</option></select></div></div>'
  +'<div class="fr"><div class="fg"><label>Phone *</label><input id="es-ph"/></div><div class="fg"><label>Email</label><input id="es-em" type="email"/></div></div>'
  +'<div class="fr"><div class="fg"><label>Join Date</label><input id="es-jd" type="date"/></div><div class="fg"><label>Salary (Rs.)</label><input id="es-sl" type="number"/></div></div>',
async()=>{if(!g('es-nm')||!g('es-rl')||!g('es-ph'))throw new Error('Name, role & phone required');await api('POST','/staff',{name:g('es-nm'),role:g('es-rl'),phone:g('es-ph'),email:g('es-em'),joinDate:g('es-jd'),salary:Number(g('es-sl'))||undefined});toast('Staff added');nav('staff');});}

function openEditStaff(id,name,role,phone,email,joinDate){openEdit('Edit Staff','Editing: '+name,
  '<div class="fr"><div class="fg"><label>Name</label><input id="es-nm" value="'+name+'"/></div><div class="fg"><label>Role</label><select id="es-rl">'+['Lab Technician','Phlebotomist','Receptionist','Home Collection','Manager','Accountant'].map(r=>'<option '+(role===r?'selected':'')+'>'+r+'</option>').join('')+'</select></div></div>'
  +'<div class="fr"><div class="fg"><label>Phone</label><input id="es-ph" value="'+phone+'"/></div><div class="fg"><label>Email</label><input id="es-em" value="'+email+'"/></div></div>'
  +'<div class="fr"><div class="fg"><label>Join Date</label><input id="es-jd" type="date" value="'+joinDate+'"/></div><div class="fg"><label>Status</label><select id="es-ac"><option value="true">Active</option><option value="false">Inactive</option></select></div></div>',
async()=>{await api('PUT','/staff/'+id,{name:g('es-nm'),role:g('es-rl'),phone:g('es-ph'),email:g('es-em'),joinDate:g('es-jd'),isActive:g('es-ac')==='true'});toast('Staff updated');nav('staff');});}

async function remStaff(id,name){if(!confirm('Remove '+name+'?'))return;try{await api('DELETE','/staff/'+id);toast('Staff removed');nav('staff');}catch(e){toast(e.message,'err');}}

if(TOKEN&&ME){launchApp();}

</script>
</body>
</html>

  slipApptId=id;
  try{
    const a=await api('GET','/appointments/'+id);
    const p=a.patient;
    document.getElementById('slip-body').innerHTML='<div class="slip-header">'
      +'<div style="font-size:1.5rem;font-weight:700;font-family:\'Playfair Display\',serif;color:var(--teal)">Sapthagiri Lab</div>'
      +'<div style="font-size:.78rem;color:var(--muted)">Munneshwara Block, Kattigenahalli, Sathanur, Bengaluru 560064</div>'
      +'<div style="font-size:.78rem;color:var(--muted)">+91 95350 12136 | info@sapthagirilab.com</div></div>'
      +'<div style="text-align:center;padding:.8rem 0;font-family:\'Playfair Display\',serif;font-size:1.2rem;color:var(--text)">APPOINTMENT SLIP</div>'
      +'<div class="slip-grid">'
      +[['Appointment No',a.appointmentCode],['Patient Name',p?.name],['Patient Code',p?.patientCode],['Phone',p?.phone],['Date',a.date],['Time',a.time],['Collection',a.collectionType==='home'?'Home Collection':'Walk-in'],['Amount','Rs.'+(a.amount||0)],['Payment',a.paid?'Paid ('+(a.paymentMethod||'')+')'  :'PENDING']].map(([l,v])=>'<div class="sfield"><span>'+l+'</span><div>'+(v||'&mdash;')+'</div></div>').join('')
      +'</div>'
      +'<div style="margin-top:1rem;padding:.7rem;background:var(--teal-pale);border-radius:6px;font-size:.8rem;color:var(--teal);text-align:center">Tests: '+(a.tests||[]).join(' &middot; ')+'</div>'
      +'<div style="margin-top:.8rem;font-size:.75rem;color:var(--muted);text-align:center">Please arrive 15 minutes early. Carry this slip and a valid photo ID.</div>';
    om('mo-slip');
  }catch(e){toast(e.message,'err');}
}

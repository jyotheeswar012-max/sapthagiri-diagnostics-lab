<script>
// BASE URL - change to your deployed backend URL
const BASE_URL_COMMENT = '/* Change BASE on next line to your server URL */';

const BASE = 'http://localhost:5000/api';
let TOKEN = localStorage.getItem('sl_token') || null;
let ME = JSON.parse(localStorage.getItem('sl_user') || 'null');
let selRole = 'patient';
let editCtx = {};
let selTests = [];
let payCtx = {};
let slipApptId = null;
const TESTS = ['Complete Blood Count','Lipid Profile','Thyroid (T3/T4/TSH)','Blood Sugar (FBS)','Liver Function Test','Kidney Function Test','HbA1c','Vitamin D','Vitamin B12','Urine Routine','ECG','COVID RT-PCR','Dengue NS1','Typhoid Widal'];

// Dark mode
function toggleDark(){
  const h=document.documentElement, dark=h.getAttribute('data-theme')==='dark';
  h.setAttribute('data-theme', dark?'light':'dark');
  localStorage.setItem('sl_theme', dark?'light':'dark');
  document.querySelectorAll('.dtgl').forEach(b=>b.textContent=dark?'🌙 Dark':'☀️ Light');
}
(function(){
  const t=localStorage.getItem('sl_theme')||'light';
  document.documentElement.setAttribute('data-theme',t);
})();

// API
async function api(method,path,body,isForm=false){
  const opts={method,headers:{...(TOKEN?{Authorization:'Bearer '+TOKEN}:{}),...(isForm?{}:{'Content-Type':'application/json'})}};
  if(body) opts.body=isForm?body:JSON.stringify(body);
  const res=await fetch(BASE+path,opts);
  const data=await res.json().catch(()=>({}));
  if(!res.ok) throw new Error(data.error||'Request failed');
  return data;
}

// Toast
function toast(msg,type=''){
  const el=document.createElement('div');
  el.className='ti'+(type?' '+type:'');
  el.textContent=msg;
  document.getElementById('toast').appendChild(el);
  setTimeout(()=>el.remove(),3800);
}

// Modal helpers
function cm(id){document.getElementById(id).classList.add('hidden');}
function om(id){document.getElementById(id).classList.remove('hidden');}
function g(id){return document.getElementById(id)?.value?.trim()||'';}
function sbadge(s){const m={completed:'b-green',upcoming:'b-blue',pending:'b-orange',cancelled:'b-red',ready:'b-green',processing:'b-orange',active:'b-green'};return'<span class="badge '+(m[s]||'b-gray')+'">'+s+'</span>';}
function errCard(e){return'<div class="card" style="color:var(--danger);border-color:var(--danger)">&#9888; '+e.message+'<br><small style="color:var(--muted)">Make sure backend is running on port 5000.</small></div>';}
function filt(inp,id){const q=inp.value.toLowerCase();document.getElementById(id)?.querySelectorAll('tr').forEach(r=>r.style.display=r.textContent.toLowerCase().includes(q)?'':'none');}
function filtCards(inp,id){const q=inp.value.toLowerCase();document.getElementById(id)?.querySelectorAll('[data-s]').forEach(el=>el.style.display=el.dataset.s.includes(q)?'':'none');}

// Landing form
function landSubmit(e){e.preventDefault();const b=e.target.querySelector('button[type=submit]');b.textContent='Sent!';b.style.background='var(--success)';setTimeout(()=>{b.textContent='Send Enquiry';b.style.background='';e.target.reset();},3000);}

// Auth
function openLogin(role){
  selRole=role||'patient';
  document.querySelectorAll('.rt').forEach(t=>t.classList.remove('active'));
  document.getElementById('rt-'+selRole)?.classList.add('active');
  document.getElementById('lerr').classList.add('hidden');
  om('mo-login');
}
function setRole(r){selRole=r;document.querySelectorAll('.rt').forEach(t=>t.classList.remove('active'));document.getElementById('rt-'+r).classList.add('active');}

async function doLogin(){
  const email=g('l-em'), pass=g('l-pw');
  const err=document.getElementById('lerr'), btn=document.getElementById('l-btn');
  err.classList.add('hidden'); btn.innerHTML='<div class="spin"></div>';
  try{
    const d=await api('POST','/auth/login',{email,password:pass,role:selRole});
    TOKEN=d.token; ME=d.user;
    localStorage.setItem('sl_token',TOKEN); localStorage.setItem('sl_user',JSON.stringify(ME));
    cm('mo-login'); launchApp();
  }catch(e){err.textContent=e.message;err.classList.remove('hidden');}
  btn.innerHTML='Sign In';
}

async function doRegister(){
  const btn=document.getElementById('r-btn'), err=document.getElementById('r-err');
  err.classList.add('hidden'); btn.innerHTML='<div class="spin"></div>';
  try{
    const d=await api('POST','/auth/register',{name:g('r-nm'),email:g('r-em'),password:g('r-pw'),phone:g('r-ph'),age:g('r-ag')||undefined,gender:g('r-gd'),bloodGroup:g('r-bg'),address:g('r-ad')});
    TOKEN=d.token; ME=d.user;
    localStorage.setItem('sl_token',TOKEN); localStorage.setItem('sl_user',JSON.stringify(ME));
    toast('Account created! Welcome to Sapthagiri Lab'); cm('mo-reg'); launchApp();
  }catch(e){err.textContent=e.message;err.classList.remove('hidden');}
  btn.innerHTML='Create Account';
}

function logout(){TOKEN=null;ME=null;localStorage.removeItem('sl_token');localStorage.removeItem('sl_user');document.getElementById('app').style.display='none';document.getElementById('landing').style.display='block';}

// App launch
function launchApp(){
  document.getElementById('landing').style.display='none';
  document.getElementById('app').style.display='block';
  document.getElementById('sb-name').textContent=ME.name;
  document.getElementById('sb-role').textContent=ME.role;
  document.getElementById('sb-av').textContent=ME.role==='doctor'?'&#x1F9FA;':ME.role==='owner'?'&#x1F451;':'&#x1F464;';
  document.getElementById('tbar-date').textContent=new Date().toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
  buildNav(); nav('dashboard');
}

const NAVMENUS={
  owner:[{s:'MAIN',i:[{ic:'&#x1F4CA;',l:'Dashboard',p:'dashboard'},{ic:'&#x1F4C5;',l:'Appointments',p:'appointments'},{ic:'&#x1F9FE;',l:'Reports',p:'reports'}]},{s:'MANAGE',i:[{ic:'&#x1F465;',l:'Patients',p:'patients'},{ic:'&#x1F4C6;',l:'Schedule',p:'schedule'},{ic:'&#x1FA7A;',l:'Doctors & Staff',p:'staff'}]},{s:'ADMIN',i:[{ic:'&#x1F4B0;',l:'Payments',p:'payments'},{ic:'&#x1F4C8;',l:'Analytics',p:'analytics'},{ic:'&#x1F514;',l:'Notifications',p:'notifications'}]}],
  doctor:[{s:'MAIN',i:[{ic:'&#x1F4CA;',l:'Dashboard',p:'dashboard'},{ic:'&#x1F4C6;',l:'My Schedule',p:'schedule'},{ic:'&#x1F4C5;',l:'Appointments',p:'appointments'}]},{s:'RECORDS',i:[{ic:'&#x1F465;',l:'My Patients',p:'patients'},{ic:'&#x1F9FE;',l:'Reports',p:'reports'},{ic:'&#x1F514;',l:'Notifications',p:'notifications'}]}],
  patient:[{s:'MAIN',i:[{ic:'&#x1F4CA;',l:'Dashboard',p:'dashboard'},{ic:'&#x1F4CB;',l:'Book a Test',p:'book'},{ic:'&#x1F4C5;',l:'Appointments',p:'appointments'}]},{s:'RECORDS',i:[{ic:'&#x1F9FE;',l:'My Reports',p:'reports'},{ic:'&#x1F4B3;',l:'Payments',p:'payments'},{ic:'&#x1F514;',l:'Notifications',p:'notifications'}]}],
};
const PTITLES={dashboard:'Dashboard',appointments:'Appointments',reports:'Reports',patients:'Patients',schedule:'Doctor Schedule',staff:'Doctors & Staff',payments:'Payments',analytics:'Analytics',notifications:'Notifications',book:'Book a Test'};

function buildNav(){
  const nb=document.getElementById('sb-nav'); nb.innerHTML='';
  (NAVMENUS[ME.role]||[]).forEach(sec=>{
    nb.insertAdjacentHTML('beforeend','<div class="sbsc">'+sec.s+'</div>');
    sec.i.forEach(item=>nb.insertAdjacentHTML('beforeend','<div class="sbi" id="nav-'+item.p+'" onclick="nav(\''+item.p+'\')"><span class="sbic">'+item.ic+'</span>'+item.l+'</div>'));
  });
}

function nav(p){
  document.querySelectorAll('.sbi').forEach(el=>el.classList.remove('active'));
  document.getElementById('nav-'+p)?.classList.add('active');
  document.getElementById('ptitle').textContent=PTITLES[p]||p;
  const c=document.getElementById('app-content');
  c.innerHTML='<div class="lr"><div class="spin"></div> Loading...</div>';
  ({dashboard:rDash,appointments:rAppts,reports:rReports,patients:rPatients,schedule:rSchedule,staff:rStaff,payments:rPayments,analytics:rAnalytics,notifications:rNotifs,book:rBook}[p]||(c=>c.innerHTML=''))(c);
}

// DASHBOARD
async function rDash(c){
  try{
    if(ME.role==='owner'){
      const [an,ap]=await Promise.all([api('GET','/analytics'),api('GET','/appointments')]);
      c.innerHTML='<div class="sr s4">'
        +'<div class="scard"><div class="sic ic-t">&#x1F465;</div><div class="si"><h4>'+an.totalPatients+'</h4><p>Patients</p></div></div>'
        +'<div class="scard"><div class="sic ic-g">&#x1F4C5;</div><div class="si"><h4>'+ap.filter(a=>a.status==='upcoming').length+'</h4><p>Upcoming</p></div></div>'
        +'<div class="scard"><div class="sic ic-gr">&#x20B9;</div><div class="si"><h4>&#x20B9;'+(an.totalRevenue||0).toLocaleString()+'</h4><p>Revenue</p></div></div>'
        +'<div class="scard"><div class="sic ic-r">&#x1F4CB;</div><div class="si"><h4>'+an.pendingReports+'</h4><p>Pending Reports</p></div></div></div>'
        +'<div style="display:grid;grid-template-columns:1.6fr 1fr;gap:1.2rem">'
        +'<div class="tcard"><div class="thead"><h3>Recent Appointments</h3></div>'
        +'<table><thead><tr><th>Patient</th><th>Tests</th><th>Date</th><th>Status</th><th>Paid</th></tr></thead><tbody>'
        +ap.slice(0,6).map(a=>'<tr><td><strong>'+(a.patient?.name||'&mdash;')+'</strong></td><td>'+(a.tests||[]).slice(0,1).join('')+(a.tests?.length>1?' +'+(a.tests.length-1):'')+'</td><td>'+a.date+'</td><td>'+sbadge(a.status)+'</td><td>'+(a.paid?'<span class="badge b-green">Paid</span>':'<span class="badge b-red">Unpaid</span>')+'</td></tr>').join('')
        +'</tbody></table></div>'
        +'<div class="card"><h3 style="font-size:.95rem;margin-bottom:1rem;color:var(--text)">Quick Stats</h3>'
        +'<div style="display:flex;flex-direction:column;gap:.65rem;font-size:.85rem">'
        +'<div style="display:flex;justify-content:space-between"><span style="color:var(--muted)">Unpaid Bills</span><strong style="color:var(--danger)">'+ap.filter(a=>!a.paid).length+'</strong></div>'
        +'<div style="display:flex;justify-content:space-between"><span style="color:var(--muted)">Reports Ready</span><strong>'+an.readyReports+'</strong></div>'
        +'<div style="display:flex;justify-content:space-between"><span style="color:var(--muted)">Doctors</span><strong>'+an.doctors+'</strong></div>'
        +'<div style="display:flex;justify-content:space-between"><span style="color:var(--muted)">Total Appointments</span><strong>'+an.totalAppointments+'</strong></div>'
        +'</div></div></div>';
    } else if(ME.role==='doctor'){
      const [pa,ap,re]=await Promise.all([api('GET','/patients'),api('GET','/appointments'),api('GET','/reports')]);
      c.innerHTML='<div class="sr s3">'
        +'<div class="scard"><div class="sic ic-t">&#x1F465;</div><div class="si"><h4>'+pa.length+'</h4><p>My Patients</p></div></div>'
        +'<div class="scard"><div class="sic ic-g">&#x1F4C5;</div><div class="si"><h4>'+ap.filter(a=>a.status==='upcoming').length+'</h4><p>Upcoming</p></div></div>'
        +'<div class="scard"><div class="sic ic-gr">&#x1F4CB;</div><div class="si"><h4>'+re.filter(r=>r.status==='ready').length+'</h4><p>Reports Ready</p></div></div></div>'
        +'<div class="tcard"><div class="thead"><h3>My Appointments</h3><button class="btn btn-primary btn-sm" onclick="nav(\'schedule\')">Schedule View</button></div>'
        +'<table><thead><tr><th>Patient</th><th>Tests</th><th>Date</th><th>Time</th><th>Status</th><th>Action</th></tr></thead><tbody>'
        +ap.slice(0,8).map(a=>'<tr><td><strong>'+(a.patient?.name||'&mdash;')+'</strong></td><td>'+(a.tests||[]).join(', ')+'</td><td>'+a.date+'</td><td>'+a.time+'</td><td>'+sbadge(a.status)+'</td><td>'+(a.status==='completed'?'<button class="btn btn-outline btn-sm" onclick="nav(\'reports\')">Reports</button>':'&mdash;')+'</td></tr>').join('')
        +'</tbody></table></div>';
    } else {
      const [ap,re]=await Promise.all([api('GET','/appointments'),api('GET','/reports')]);
      c.innerHTML='<div class="sr s3">'
        +'<div class="scard"><div class="sic ic-t">&#x1F4C5;</div><div class="si"><h4>'+ap.length+'</h4><p>Appointments</p></div></div>'
        +'<div class="scard"><div class="sic ic-gr">&#x1F9FE;</div><div class="si"><h4>'+re.filter(r=>r.status==='ready').length+'</h4><p>Reports Ready</p></div></div>'
        +'<div class="scard"><div class="sic ic-g">&#x23F3;</div><div class="si"><h4>'+ap.filter(a=>a.status==='upcoming').length+'</h4><p>Upcoming</p></div></div></div>'
        +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem">'
        +'<div class="tcard"><div class="thead"><h3>My Appointments</h3><button class="btn btn-primary btn-sm" onclick="nav(\'book\')">+ Book</button></div>'
        +'<table><thead><tr><th>Tests</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>'
        +ap.map(a=>'<tr><td>'+(a.tests||[]).slice(0,1).join('')+(a.tests?.length>1?' +'+(a.tests.length-1):'')+'</td><td>'+a.date+'</td><td>'+sbadge(a.status)+'</td><td>'+(!a.paid?'<button class="btn btn-gold btn-sm" onclick="openPayModal(\''+a._id+'\',\''+a.patient?.name+'\','+a.amount+')">Pay</button>':'')+'</td></tr>').join('')
        +'</tbody></table></div>'
        +'<div class="card"><h3 style="font-size:.95rem;margin-bottom:1rem;color:var(--text)">Recent Reports</h3>'
        +re.map(r=>'<div class="rc"><div class="rci">&#x1F4CB;</div><div class="rci-info"><strong>'+r.testName+'</strong><span>'+(r.createdAt||'').split('T')[0]+' &middot; '+sbadge(r.status)+'</span></div>'+(r.status==='ready'?'<button class="btn btn-outline btn-sm" onclick="dlReport(\''+r._id+'\')">&#x2B07; PDF</button>':'')+'</div>').join('')
        +'</div></div>';
    }
  }catch(e){c.innerHTML=errCard(e);}
}

// APPOINTMENTS
async function rAppts(c){
  try{
    const ap=await api('GET','/appointments');
    c.innerHTML='<div class="tcard"><div class="thead"><h3>Appointments</h3>'
      +'<div class="ta"><input placeholder="Search..." oninput="filt(this,\'apt-t\')"/>'
      +(ME.role==='patient'?'<button class="btn btn-primary btn-sm" onclick="nav(\'book\')">+ Book</button>':'')
      +(ME.role==='owner'?'<button class="btn btn-primary btn-sm" onclick="openAddAppt()">+ Add</button>':'')
      +'</div></div>'
      +'<table><thead><tr><th>Code</th><th>Patient</th><th>Tests</th><th>Date</th><th>Time</th><th>Status</th><th>Paid</th><th>Actions</th></tr></thead>'
      +'<tbody id="apt-t">'
      +ap.map(a=>'<tr>'
        +'<td><code style="font-size:.73rem">'+(a.appointmentCode||'&mdash;')+'</code></td>'
        +'<td><strong>'+(a.patient?.name||'&mdash;')+'</strong></td>'
        +'<td style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+(a.tests||[]).join(', ')+'</td>'
        +'<td>'+a.date+'</td><td>'+a.time+'</td>'
        +'<td>'+sbadge(a.status)+'</td>'
        +'<td>'+(a.paid?'<span class="badge b-green">Paid</span>':'<span class="badge b-red">Unpaid</span>')+'</td>'
        +'<td><div style="display:flex;gap:.3rem;flex-wrap:wrap">'
        +(ME.role!=='patient'?'<button class="btn btn-outline btn-sm" onclick="openEditAppt(\''+a._id+'\')">&#x270F;</button>':'')
        +(ME.role==='patient'&&a.status==='upcoming'?'<button class="btn btn-outline btn-sm" onclick="openEditAppt(\''+a._id+'\')">Reschedule</button>':'')
        +'<button class="btn btn-ghost btn-sm" onclick="printSlip(\''+a._id+'\')">&#x1F5A8;</button>'
        +(!a.paid?'<button class="btn btn-gold btn-sm" onclick="openPayModal(\''+a._id+'\',\''+(a.patient?.name||ME.name)+'\','+a.amount+')">&#x1F4B3; Pay</button>':'')
        +(a.paid?'<button class="btn btn-ghost btn-sm" onclick="dlReceipt(\''+a._id+'\')">&#x1F9FE;</button>':'')
        +(ME.role!=='patient'&&a.status!=='cancelled'&&a.status!=='completed'?'<button class="btn btn-danger btn-sm" onclick="cancelAppt(\''+a._id+'\')">&#x2715;</button>':'')
        +'</div></td></tr>').join('')
      +'</tbody></table></div>';
  }catch(e){c.innerHTML=errCard(e);}
}


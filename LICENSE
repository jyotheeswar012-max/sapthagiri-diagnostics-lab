// BOOKING
function rBook(c){
  selTests=[];
  c.innerHTML='<div style="max-width:680px"><div class="card">'
    +'<h3 style="font-family:\'Playfair Display\',serif;font-size:1.1rem;margin-bottom:1.4rem;color:var(--text)">Book a Diagnostic Test</h3>'
    +'<div class="fg"><label>Select Tests</label><div class="tpicker" id="tpick">'
    +TESTS.map(t=>'<div class="tchip" onclick="togTest(this,\''+t+'\')">'+t+'</div>').join('')
    +'</div></div>'
    +'<div class="fr">'
    +'<div class="fg"><label>Date</label><input type="date" id="bk-dt" min="'+new Date().toISOString().split('T')[0]+'"/></div>'
    +'<div class="fg"><label>Time</label><select id="bk-tm"><option>07:00</option><option>08:00</option><option>09:00</option><option>10:00</option><option>11:00</option><option>12:00</option><option>14:00</option><option>15:00</option><option>16:00</option></select></div></div>'
    +'<div class="fg"><label>Collection Type</label><select id="bk-col" onchange="document.getElementById(\'bk-hg\').style.display=this.value===\'home\'?\'block\':\'none\'"><option value="walkin">Walk-in at Lab</option><option value="home">Home Collection (+Rs.150)</option></select></div>'
    +'<div class="fg hidden" id="bk-hg"><label>Home Address</label><textarea rows="2" id="bk-ad" placeholder="Full address for home collection"></textarea></div>'
    +'<div class="card hidden" id="bk-sum" style="background:var(--teal-pale);border:1.5px solid var(--teal);margin-top:1rem"><h3 style="font-size:.88rem;color:var(--teal);margin-bottom:.5rem">Booking Summary</h3><div id="bk-sb"></div></div>'
    +'<div style="display:flex;gap:.7rem;margin-top:1.2rem">'
    +'<button class="btn btn-ghost" onclick="prevBook()">Preview</button>'
    +'<button class="btn btn-primary" onclick="confBook()">Confirm &amp; Book</button>'
    +'</div></div></div>';
}
function togTest(el,t){el.classList.toggle('sel');selTests=el.classList.contains('sel')?[...selTests,t]:selTests.filter(x=>x!==t);}
function prevBook(){
  if(!selTests.length){toast('Select at least one test','err');return;}
  const dt=g('bk-dt'),col=g('bk-col'); if(!dt){toast('Select a date','err');return;}
  const total=selTests.length*350+(col==='home'?150:0);
  const s=document.getElementById('bk-sum'); s.classList.remove('hidden');
  document.getElementById('bk-sb').innerHTML='<div style="font-size:.85rem;line-height:2">'
    +'<div style="display:flex;justify-content:space-between"><span>Tests</span><span>'+selTests.join(', ')+'</span></div>'
    +'<div style="display:flex;justify-content:space-between"><span>Date</span><span>'+dt+' at '+g('bk-tm')+'</span></div>'
    +'<div style="display:flex;justify-content:space-between"><span>Collection</span><span>'+(col==='home'?'Home (+Rs.150)':'Walk-in')+'</span></div>'
    +'<div style="display:flex;justify-content:space-between;font-weight:700;color:var(--teal);border-top:1px solid var(--border);padding-top:.4rem"><span>Total</span><span>Rs.'+total+'</span></div></div>';
}
async function confBook(){
  if(!selTests.length){toast('Select tests first','err');return;}
  const dt=g('bk-dt'); if(!dt){toast('Select a date','err');return;}
  const col=g('bk-col'),ad=g('bk-ad');
  try{
    const ap=await api('POST','/appointments',{tests:selTests,date:dt,time:g('bk-tm'),collectionType:col,homeAddress:ad,amount:selTests.length*350+(col==='home'?150:0)});
    toast('Appointment '+ap.appointmentCode+' booked! SMS sent to your phone.'); nav('appointments');
  }catch(e){toast(e.message,'err');}
}

// RAZORPAY
async function openPayModal(id,name,amount){
  payCtx={id,name,amount};
  document.getElementById('pay-amt').textContent='Rs.'+amount;
  document.getElementById('pay-det').innerHTML='<div class="pd"><span style="color:var(--muted)">Patient</span><strong>'+name+'</strong></div><div class="pd"><span style="color:var(--muted)">Amount</span><strong>Rs.'+amount+'</strong></div><div class="pd"><span style="color:var(--muted)">Gateway</span><strong>Razorpay (UPI/Card/NetBanking)</strong></div>';
  om('mo-pay');
}

async function launchRzp(){
  const btn=document.getElementById('pay-btn'); btn.innerHTML='<div class="spin"></div>';
  try{
    const order=await api('POST','/payments/create-order',{appointmentId:payCtx.id});
    if(order.demo){
      await api('POST','/payments/verify',{razorpay_order_id:order.orderId,razorpay_payment_id:'pay_DEMO',razorpay_signature:'demo',appointmentId:payCtx.id,demo:true});
      cm('mo-pay'); toast('Payment of Rs.'+payCtx.amount+' successful! SMS confirmation sent.'); nav('payments'); return;
    }
    new Razorpay({key:order.keyId,amount:order.amount,currency:order.currency,name:'Sapthagiri Lab',description:'Lab Test Payment',order_id:order.orderId,
      handler:async function(r){await api('POST','/payments/verify',{...r,appointmentId:payCtx.id});cm('mo-pay');toast('Payment successful! SMS sent.');nav('payments');},
      prefill:{name:payCtx.name},theme:{color:'#0a6e6e'}}).open();
  }catch(e){toast(e.message,'err');}
  btn.innerHTML='Pay Now';
}

async function markCash(id){try{await api('PATCH','/appointments/'+id+'/pay',{paymentMethod:'Cash'});toast('Cash payment recorded');nav('payments');}catch(e){toast(e.message,'err');}}
function dlReceipt(id){window.open(BASE+'/payments/receipt/'+id+'?token='+TOKEN,'_blank');}
function dlReport(id){window.open(BASE+'/reports/'+id+'/pdf?token='+TOKEN,'_blank');}

